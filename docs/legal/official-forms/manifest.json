  "registry_version": 1,
  "created_on": "2026-08-12",
  "scope": "OwnerPilot controlled official blank court-form source registry",
  "governance_status": "NON-PRODUCTION SOURCE ARTIFACTS",
  "source_policy": "Prefer the current issuing-authority binary. Preserve Founder-supplied candidate hashes for provenance and explicitly disclose any bytewise discrepancy rather than silently substituting it. If a registered authority binary later changes while the published revision remains unchanged, retain the prior registered artifact and ingest the changed binary under a distinct immutable source-snapshot/version identity rather than overwriting it in place.",
  "workflow_stage_semantics": "Lifecycle classification only. workflow_stage does not establish requiredness, applicability, filing readiness, legal sufficiency, or a timing obligation.",
  "source_currentness_semantics": "binary_ingestion_verified_on records the source-verification snapshot for this registry ingestion; it is not an evergreen claim that an authority URL remains unchanged. Future source checks must preserve prior registered binaries and provenance when drift is detected.",
  "registry_contract": {
    "version_policy": "registry_version identifies the manifest contract. Consumers must fail closed on an unsupported registry_version rather than guessing field semantics.",
    "required_entry_fields": [
      "artifact_id",
      "authority_key",
      "form_id",
      "issuing_authority",
      "jurisdiction",
      "revision_effective",
      "source_snapshot_id",
      "repository_path",
      "repository_sha256",
      "source_url",
      "page_count",
      "artifact_class",
      "repository_status"
    ],
    "published_revision_identity": "authority_key + form_id + revision_effective identifies the issuing authority's published revision, but does not uniquely identify exact PDF bytes.",
    "source_snapshot_identity": "source_snapshot_id is content-addressed as sha256:<repository_sha256> and identifies the exact registered binary independently of filename, repository path, mutable remote URL, or customer Matter.",
    "artifact_identity": "artifact_id combines authority_key + form_id + revision_effective + source_snapshot_id. SHA-256 therefore participates in exact artifact identity while published revision identity remains separately addressable.",
    "duplicate_rules": "artifact_id and repository_path must each be unique. Multiple artifacts may share authority_key + form_id + revision_effective only when source_snapshot_id/repository_sha256 differ and each historical binary/path remains immutable.",
    "same_revision_drift_path_policy": "The first registered revision path remains immutable. If later authority bytes drift under the same published revision, store the new binary at <FORM-ID>/<REVISION>/source-snapshots/sha256-<FULL_SHA256>/<FORM-ID>.pdf (under the same authority root) and add a new manifest entry; never overwrite an existing repository_path.",
    "artifact_class_values": [
      "official_blank"
    ],
    "repository_status_values": [
      "present_hash_and_blankness_verified"
    ],
    "malformed_entry_policy": "A future machine consumer must reject/fail closed on missing required identity fields, malformed hashes, duplicate artifact_id/repository_path values, unsupported artifact classes, or hash/path mismatch; it must not infer applicability or requiredness from registry presence."
  },
  "future_retrieval_contract": {
    "status": "FOUNDATION_ONLY_NOT_IMPLEMENTED",
    "verification_chain": "requested artifact_id -> manifest repository_path -> exact repository binary -> SHA-256 equals repository_sha256/source_snapshot_id -> supported artifact_class before any future field-map/document subsystem may bind to it",
    "fail_closed_states": [
      "MISSING",
      "HASH_MISMATCH",
      "MALFORMED_ARTIFACT",
      "UNSUPPORTED_ARTIFACT",
      "SOURCE_HEALTH_UNRESOLVED"
    ],
    "source_health_boundary": "Source health/currentness is a future control distinct from historical artifact identity. CURRENT/STALE/CHANGED/UNAVAILABLE/UNRESOLVED health must never rewrite or delete a registered artifact identity."
  },
  "blankness_verification": {
    "method": "PDF AcroForm inspection on the exact repository binary",
    "accepted_values": "No nonempty field values; /Off checkbox state is treated as blank.",
    "verified_on": "2026-08-12"
  },
  "binary_ingestion_status": "complete_hash_and_blankness_verified",
  "binary_ingestion_verified_on": "2026-08-12",
